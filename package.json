{
  "name": "@imwyvern/agent-guard",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP runtime decoy routes + inert canary credentials that alert when AI agents or scanners take the bait.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.6",
    "@lhci/cli": "^0.16.0",
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "autocannon": "^9.0.0",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "graphql": "^17.1.0",
    "hono": "^4.13.17",
    "koa": "^3.3.0",
    "miniflare": "4.20260730.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-guard": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.ts",
        "default": "./dist/hono.js"
      },
      "require": {
        "types": "./dist/hono.d.cts",
        "default": "./dist/hono.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./koa": {
      "import": {
        "types": "./dist/koa.d.ts",
        "default": "./dist/koa.js"
      },
      "require": {
        "types": "./dist/koa.d.cts",
        "default": "./dist/koa.cjs"
      }
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "import": "./dist/workers.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./deno": {
      "types": "./dist/deno.d.ts",
      "import": "./dist/deno.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js"
    },
    "./hono-web": {
      "types": "./dist/hono-web.d.ts",
      "import": "./dist/hono-web.js"
    }
  },
  "typesVersions": {
    "*": {
      "express": [
        "dist/express.d.ts"
      ],
      "node": [
        "dist/node.d.ts"
      ],
      "hono": [
        "dist/hono.d.ts"
      ],
      "fastify": [
        "dist/fastify.d.ts"
      ],
      "koa": [
        "dist/koa.d.ts"
      ],
      "web": [
        "dist/web.d.ts"
      ],
      "workers": [
        "dist/workers.d.ts"
      ],
      "next": [
        "dist/next.d.ts"
      ],
      "deno": [
        "dist/deno.d.ts"
      ],
      "bun": [
        "dist/bun.d.ts"
      ],
      "hono-web": [
        "dist/hono-web.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "express": ">=4",
    "fastify": ">=4",
    "hono": ">=4",
    "koa": ">=2"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "koa": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "check:neutral": "tsx scripts/check-neutral.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "node --import tsx bench/run.ts",
    "bench:exhaust-sim": "node --import tsx bench/exhaust-sim.ts",
    "bench:deception-lint": "node --import tsx bench/deception-lint.ts",
    "bench:simulate": "node --import tsx bench/simulate.ts",
    "bench:latency": "node --import tsx bench/latency.ts",
    "bench:latency:hr": "node --import tsx bench/latency-hr.ts",
    "bench:latency:web": "node --import tsx bench/latency-web.ts",
    "smoke:workers": "node --import tsx scripts/smoke-workers.ts",
    "smoke:bun": "bun scripts/smoke-bun.ts",
    "smoke:deno": "deno run --allow-net=127.0.0.1 scripts/smoke-deno.ts",
    "lhci": "node --import tsx bench/lighthouse.ts",
    "demo:express": "node --import tsx examples/express-demo/server.ts",
    "demo:node": "node --import tsx examples/node-http-demo/server.ts",
    "demo:hono": "node --import tsx examples/hono-demo/server.ts",
    "demo:fastify": "node --import tsx examples/fastify-demo/server.ts",
    "demo:koa": "node --import tsx examples/koa-demo/server.ts",
    "demo:mcp": "node --import tsx examples/mcp-decoy/server.ts",
    "demo:graphql": "node --import tsx examples/graphql-demo/server.ts"
  }
}
