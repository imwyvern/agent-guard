# Complete nginx.conf for a gateway on the Docker host. Replace example.com
# and certificate paths with operator-managed TLS material outside this repo.
# Guard handles verified-crawler exemptions. Preserve decoy bodies and
# noindex / robots headers; do not add error interception or response rewriting.
events {}
http {
    server {
        listen 443 ssl;
        server_name example.com;
        ssl_certificate /etc/nginx/tls/fullchain.pem;
        ssl_certificate_key /etc/nginx/tls/privkey.pem;
        location / {
            proxy_pass http://127.0.0.1:8080;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Connection "";
        }
    }
}
